    "@sendgrid/mail": "^8.1.3",
    "aes-js": "^3.1.2",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.1",
    "node-binance-api": "github:luiztools/node-binance-api",
    "node-schedule": "^2.1.1",
    "punycode": "^2.3.1",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "technicalindicators": "^3.1.0",
